{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-sphere.com/schemas/addon-manifest-v1.json",
  "title": "RED-CMS Add-On Manifest v1",
  "description": "Data-only trust manifest. Reading or validating this document must never execute package PHP.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "type",
    "compatibility",
    "provides",
    "dependencies",
    "permissions",
    "settings",
    "migrations",
    "routes",
    "jobs",
    "outboundHosts",
    "assets",
    "integrity",
    "uninstall"
  ],
  "properties": {
    "$schema": {
      "const": "https://red-sphere.com/schemas/addon-manifest-v1.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/packageId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "type": {
      "enum": [
        "component",
        "service",
        "adapter",
        "content-package",
        "cross-cutting"
      ]
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cms", "php"],
      "properties": {
        "cms": {
          "$ref": "#/$defs/versionRange"
        },
        "php": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "services", "adminTools", "adapters"],
      "properties": {
        "components": {
          "$ref": "#/$defs/capabilityList"
        },
        "services": {
          "$ref": "#/$defs/capabilityList"
        },
        "adminTools": {
          "$ref": "#/$defs/capabilityList"
        },
        "adapters": {
          "$ref": "#/$defs/capabilityList"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/permission"
      }
    },
    "componentEditors": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/componentEditor"
      }
    },
    "adminToolContracts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/adminToolContract"
      }
    },
    "adminToolFormContracts": {
      "description": "Optional data-only declarations for future core-owned administrator forms. Declarations do not render controls, parse a body, consume CSRF, invoke package PHP, create an endpoint, or change enablement eligibility.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/adminToolFormContract"
      }
    },
    "adminToolActionContracts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/adminToolActionContract"
      }
    },
    "publicMutationContracts": {
      "description": "Optional data-only declarations for future core-owned public POST mutations. Declarations do not create a route, handler, session, cookie, database write, or enablement eligibility.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/publicMutationContract"
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/setting"
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/migration"
      }
    },
    "routes": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/route"
      }
    },
    "jobs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/job"
      }
    },
    "outboundHosts": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/hostname"
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "admin"],
      "properties": {
        "public": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "admin": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "files"],
      "properties": {
        "entrypoint": {
          "const": "addon.php"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDataAction", "allowExplicitPurge"],
      "properties": {
        "defaultDataAction": {
          "const": "retain"
        },
        "allowExplicitPurge": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "packageId": {
      "type": "string",
      "maxLength": 127,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?\\.[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?:(?:>=|<=|>|<|==|=)?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?)(?: (?:(?:>=|<=|>|<|==|=)?[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:-[0-9A-Za-z.-]+)?))*$"
    },
    "capability": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9.-]*(?:/[a-z0-9][a-z0-9.-]*)?$"
    },
    "componentFieldKey": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "permission": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "$ref": "#/$defs/versionRange"
        }
      }
    },
    "componentEditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "label",
        "description",
        "icon",
        "permissions",
        "fields"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/capability"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "create",
            "view",
            "edit",
            "delete",
            "publish",
            "restore"
          ],
          "properties": {
            "create": {
              "$ref": "#/$defs/permission"
            },
            "view": {
              "$ref": "#/$defs/permission"
            },
            "edit": {
              "$ref": "#/$defs/permission"
            },
            "delete": {
              "$ref": "#/$defs/permission"
            },
            "publish": {
              "$ref": "#/$defs/permission"
            },
            "restore": {
              "$ref": "#/$defs/permission"
            }
          }
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/componentField"
          }
        }
      }
    },
    "adminToolContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "label",
        "description",
        "icon",
        "permission",
        "mode"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/capability"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "mode": {
          "const": "read-only"
        }
      }
    },
    "adminToolActionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "action",
        "label",
        "description",
        "permission",
        "method",
        "csrf",
        "idempotency"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/capability"
        },
        "action": {
          "$ref": "#/$defs/capability"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "method": {
          "const": "POST"
        },
        "csrf": {
          "const": "required"
        },
        "idempotency": {
          "const": "once-per-target"
        }
      }
    },
    "adminToolFormContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "form",
        "label",
        "description",
        "permission",
        "method",
        "csrf",
        "encoding",
        "maxBodyBytes"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/capability"
        },
        "form": {
          "$ref": "#/$defs/capability"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "permission": {
          "$ref": "#/$defs/permission"
        },
        "method": {
          "const": "POST"
        },
        "csrf": {
          "const": "required"
        },
        "encoding": {
          "const": "application/json"
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    },
    "publicMutationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "mutation",
        "scope",
        "authentication",
        "method",
        "csrf",
        "encoding",
        "maxBodyBytes",
        "requestFields",
        "subject",
        "idempotency",
        "privacy",
        "rateLimit",
        "tables",
        "postcondition",
        "audit",
        "outcomes"
      ],
      "properties": {
        "route": {
          "$ref": "#/$defs/capability"
        },
        "mutation": {
          "$ref": "#/$defs/capability"
        },
        "scope": {
          "const": "public"
        },
        "authentication": {
          "const": "public"
        },
        "method": {
          "const": "POST"
        },
        "csrf": {
          "const": "required"
        },
        "encoding": {
          "const": "application/x-www-form-urlencoded"
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 8192
        },
        "requestFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/publicMutationIdentifierField"
              },
              {
                "$ref": "#/$defs/publicMutationPositiveIntegerField"
              }
            ]
          }
        },
        "subject": {
          "const": "anonymous"
        },
        "idempotency": {
          "const": "core-issued-key"
        },
        "privacy": {
          "const": "no-store"
        },
        "rateLimit": {
          "const": "required"
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/publicMutationTable"
          }
        },
        "postcondition": {
          "const": "server-derived-state"
        },
        "audit": {
          "$ref": "#/$defs/publicMutationAuditCategory"
        },
        "outcomes": {
          "const": ["accepted", "unchanged"]
        }
      }
    },
    "publicMutationIdentifierField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "required", "minLength", "maxLength"],
      "properties": {
        "key": {
          "$ref": "#/$defs/componentFieldKey"
        },
        "type": {
          "const": "identifier"
        },
        "required": {
          "type": "boolean"
        },
        "minLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 160
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 160
        }
      }
    },
    "publicMutationPositiveIntegerField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "required", "minimum", "maximum"],
      "properties": {
        "key": {
          "$ref": "#/$defs/componentFieldKey"
        },
        "type": {
          "const": "positive-integer"
        },
        "required": {
          "type": "boolean"
        },
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "publicMutationTable": {
      "type": "string",
      "pattern": "^RED_Addon_[A-Za-z0-9_]{1,54}$"
    },
    "publicMutationAuditCategory": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "componentField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "required"],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "integer",
            "boolean",
            "select",
            "url",
            "email",
            "date",
            "datetime",
            "media-reference"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "help": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "minimum": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "maximum": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/componentFieldOption"
          }
        }
      }
    },
    "componentFieldOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type", "secret"],
      "properties": {
        "key": {
          "$ref": "#/$defs/permission"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "type": {
          "enum": [
            "text",
            "boolean",
            "integer",
            "select",
            "url",
            "email",
            "secret-reference"
          ]
        },
        "secret": {
          "type": "boolean"
        },
        "permission": {
          "description": "Optional package-declared permission required by operational setting storage and editing boundaries.",
          "$ref": "#/$defs/permission"
        },
        "default": {
          "description": "A non-secret default. PHP trust validation also requires the value to match the declared setting type; null means no configured default.",
          "type": ["string", "integer", "boolean", "null"]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^migrations/[A-Za-z0-9_.-]+\\.sql$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "path",
        "methods",
        "authentication",
        "csrf"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capability"
        },
        "scope": {
          "enum": ["public", "admin"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_{}.-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_{}.-]+)*$"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          }
        },
        "authentication": {
          "enum": ["public", "admin", "member"]
        },
        "csrf": {
          "enum": ["required", "not-applicable"]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "maxAttempts", "backoffSeconds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/capability"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "backoffSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "hostname": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "location"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "location": {
          "enum": ["head", "body-end"]
        }
      }
    }
  }
}
