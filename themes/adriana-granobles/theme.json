{
  "$schema": "../../docs/theme-manifest.schema.json",
  "schemaVersion": 1,
  "id": "adriana-granobles",
  "name": "Adriana Granobles — Conservatorio Íntimo",
  "version": "0.1.2",
  "type": "standard",
  "description": "Portable RED-CMS theme adapted from the current 28-page Adriana Granobles HTML5 source, with editorial music-school styling, responsive navigation, manual feature slides, and five reusable page-pattern layouts.",
  "preview": "preview.svg",
  "compatibility": {
    "cms": ">=4.0",
    "php": ">=8.2",
    "layoutAliases": {
      "Full-Width": "index-2"
    }
  },
  "assets": {
    "styles": [
      {
        "id": "adriana-theme",
        "path": "assets/css/theme.css",
        "location": "head"
      }
    ],
    "scripts": []
  },
  "production": {
    "assets": {
      "styles": [
        {
          "id": "adriana-production",
          "path": "assets/css/production.css",
          "location": "head"
        },
        {
          "id": "adriana-production-forms",
          "path": "assets/css/production-forms.css",
          "location": "head"
        }
      ],
      "scripts": [
        {
          "id": "adriana-accessibility",
          "path": "assets/js/accessibility.js",
          "location": "body-end"
        },
        {
          "id": "adriana-animations",
          "path": "assets/js/animations.js",
          "location": "body-end"
        },
        {
          "id": "adriana-site",
          "path": "assets/js/site.js",
          "location": "body-end"
        },
        {
          "id": "adriana-hero-slider",
          "path": "assets/js/hero-slider.js",
          "location": "body-end"
        }
      ]
    },
    "regions": {
      "document": { "template": "templates/production-page.php" },
      "header": { "template": "partials/production-header.php" },
      "navigation": { "template": "partials/production-navigation.php" },
      "hero": { "template": "partials/production-hero.php" },
      "footer": { "template": "partials/production-footer.php" }
    },
    "layouts": {
      "index": { "template": "layouts/production-index.php" },
      "index-1": { "template": "layouts/production-index-1.php" },
      "index-2": { "template": "layouts/production-index-2.php" },
      "index-3": { "template": "layouts/production-index-3.php" },
      "feature-grid": { "template": "layouts/production-feature-grid.php" },
      "home-editorial": { "template": "layouts/production-home-editorial.php" },
      "directory-hub": { "template": "layouts/production-directory-hub.php" },
      "service-detail": { "template": "layouts/production-service-detail.php" },
      "campaign-story": { "template": "layouts/production-campaign-story.php" },
      "contact-conversion": { "template": "layouts/production-contact-conversion.php" }
    },
    "components": {
      "Article": { "template": "components/production-article.php" },
      "Form": { "template": "components/production-form.php" },
      "Gallery": { "template": "components/production-gallery.php" },
      "Other": { "template": "components/production-other.php" }
    }
  },
  "regions": {
    "document": {
      "label": "Document shell",
      "required": true,
      "template": "templates/page.php"
    },
    "header": {
      "label": "Website header",
      "required": true,
      "template": "partials/header.php"
    },
    "navigation": {
      "label": "Main navigation",
      "required": true,
      "template": "partials/navigation.php"
    },
    "hero": {
      "label": "Feature hero",
      "required": false,
      "template": "partials/hero.php"
    },
    "footer": {
      "label": "Website footer",
      "required": true,
      "template": "partials/footer.php"
    }
  },
  "layouts": {
    "index": {
      "label": "Two columns and a full-width row",
      "template": "layouts/index.php",
      "positions": [
        { "id": 1, "label": "Left column" },
        { "id": 2, "label": "Right column" },
        { "id": 3, "label": "Full-width row" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }, { "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "index-1": {
      "label": "Full-width row and three columns",
      "template": "layouts/index-1.php",
      "positions": [
        { "id": 1, "label": "Full-width row" },
        { "id": 2, "label": "Left column" },
        { "id": 3, "label": "Center column" },
        { "id": 4, "label": "Right column" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [
            { "position": 2, "weight": 1 },
            { "position": 3, "weight": 1 },
            { "position": 4, "weight": 1 }
          ]
        ]
      },
      "hiddenPosition": 0
    },
    "index-2": {
      "label": "Four stacked full-width rows",
      "template": "layouts/index-2.php",
      "positions": [
        { "id": 1, "label": "Row one" },
        { "id": 2, "label": "Row two" },
        { "id": 3, "label": "Row three" },
        { "id": 4, "label": "Row four" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }],
          [{ "position": 4, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "index-3": {
      "label": "Main content and right sidebar",
      "template": "layouts/index-3.php",
      "positions": [
        { "id": 1, "label": "Main content" },
        { "id": 2, "label": "Right sidebar" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 2 }, { "position": 2, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "feature-grid": {
      "label": "Feature row, three-card grid, and closing row",
      "template": "layouts/feature-grid.php",
      "positions": [
        { "id": 1, "label": "Lead feature" },
        { "id": 2, "label": "Left card" },
        { "id": 3, "label": "Center card" },
        { "id": 4, "label": "Right card" },
        { "id": 5, "label": "Closing row" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [
            { "position": 2, "weight": 1 },
            { "position": 3, "weight": 1 },
            { "position": 4, "weight": 1 }
          ],
          [{ "position": 5, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "home-editorial": {
      "label": "Adriana home editorial",
      "template": "layouts/home-editorial.php",
      "positions": [
        { "id": 1, "label": "Primary pathways" },
        { "id": 2, "label": "Brand story" },
        { "id": 3, "label": "Programs and instruments" },
        { "id": 4, "label": "Proof and testimonials" },
        { "id": 5, "label": "Closing call to action" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }],
          [{ "position": 4, "weight": 1 }],
          [{ "position": 5, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "directory-hub": {
      "label": "Directory and service hub",
      "template": "layouts/directory-hub.php",
      "positions": [
        { "id": 1, "label": "Hub introduction" },
        { "id": 2, "label": "Directory cards" },
        { "id": 3, "label": "Method or guidance" },
        { "id": 4, "label": "Frequently asked questions" },
        { "id": 5, "label": "Closing call to action" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }],
          [{ "position": 4, "weight": 1 }],
          [{ "position": 5, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "service-detail": {
      "label": "Service or instrument detail",
      "template": "layouts/service-detail.php",
      "positions": [
        { "id": 1, "label": "Service overview" },
        { "id": 2, "label": "Benefits or objectives" },
        { "id": 3, "label": "Method and audience" },
        { "id": 4, "label": "Proof, media, or FAQ" },
        { "id": 5, "label": "Closing call to action" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }],
          [{ "position": 4, "weight": 1 }],
          [{ "position": 5, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "campaign-story": {
      "label": "Long-form campaign story",
      "template": "layouts/campaign-story.php",
      "positions": [
        { "id": 1, "label": "Campaign introduction" },
        { "id": 2, "label": "Story and benefits" },
        { "id": 3, "label": "Media and social proof" },
        { "id": 4, "label": "Journey and resources" },
        { "id": 5, "label": "Closing call to action" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 1 }],
          [{ "position": 3, "weight": 1 }],
          [{ "position": 4, "weight": 1 }],
          [{ "position": 5, "weight": 1 }]
        ]
      },
      "hiddenPosition": 0
    },
    "contact-conversion": {
      "label": "Contact conversion",
      "template": "layouts/contact-conversion.php",
      "positions": [
        { "id": 1, "label": "Contact introduction" },
        { "id": 2, "label": "CMS contact form" },
        { "id": 3, "label": "Contact details and alternatives" }
      ],
      "adminPreview": {
        "rows": [
          [{ "position": 1, "weight": 1 }],
          [{ "position": 2, "weight": 7 }, { "position": 3, "weight": 5 }]
        ]
      },
      "hiddenPosition": 0
    }
  },
  "components": {
    "Article": {
      "label": "Article",
      "template": "components/article.php"
    },
    "Form": {
      "label": "Form",
      "template": "components/form.php"
    },
    "Gallery": {
      "label": "Gallery",
      "template": "components/gallery.php"
    },
    "Other": {
      "label": "Other",
      "template": "components/other.php"
    }
  },
  "settings": [
    {
      "key": "branding.logo",
      "label": "Website logo",
      "type": "image",
      "legacyItem": "Website_Logo"
    },
    {
      "key": "navigation.breadcrumbs",
      "label": "Show breadcrumbs",
      "type": "checkbox",
      "default": false
    }
  ],
  "knownLimitations": [
    "The package ports the current 28-page visual and interaction system; page content and media remain a separate CMS migration task.",
    "RED-CMS exposes one display-only Home fixture preview for this package; exact migrated-route QA still requires the disposable runtime before activation.",
    "Analytics, Tag Manager, Jotform injection, external embeds, and privacy-consent behavior are intentionally outside the theme shell.",
    "Production Form submission remains entirely owned by RED-CMS endpoints and is not intercepted by theme JavaScript."
  ]
}
